# Pushes the ready-to-publish videos to Google Drive whenever a delivery or a package changes.
# Install: systemctl --user link $PWD/srstudio-drive.{path,service} && systemctl --user enable --now srstudio-drive.path
[Unit]
Description=Watch Instagram deliveries and packages for the Drive outbox

[Path]
# `instagram_posts.py deliver` rewrites delivery.json on every delivery; packages land in videos-styles.
PathChanged=%h/worskpace/generated/renders/ig
PathChanged=%h/worskpace/videos-styles
Unit=srstudio-drive.service

[Install]
WantedBy=default.target
