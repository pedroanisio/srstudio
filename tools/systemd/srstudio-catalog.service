# Writes ~/worskpace/catalogo-scene-render.html with `srstudio page`; started by srstudio-catalog.path.
[Unit]
Description=Rebuild the scene-render catalog page

[Service]
Type=oneshot
WorkingDirectory=%h/worskpace
UMask=0077
# A render is written over many seconds: wait until no render changed for 15 s, at most 60 checks (5 min).
ExecStartPre=/bin/sh -c 'n=0; while [ "$$n" -lt 60 ] && [ -n "$$(find generated/renders -newermt "15 seconds ago" -print -quit)" ]; do sleep 5; n=$$((n + 1)); done'
ExecStart=%h/worskpace/.venv/bin/srstudio page \
    --base generated/catalog/packages-base.html \
    --episodes generated/episodes \
    --renders generated/renders \
    --notes srstudio/docs/catalog/notes.json \
    --cache generated/catalog/cache \
    --engine generated/bin/scene-render \
    --out catalogo-scene-render.html
Environment=SRSTUDIO_PACKAGES=%h/worskpace/generated/packages
