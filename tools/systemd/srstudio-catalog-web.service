# Serves ~/worskpace/generated/catalog/site with `srstudio serve`. It has no authentication: keep the bind on loopback.
# It exits with an error until srstudio-catalog.service has built the site once; Restart= brings it up after that.
# Install: systemctl --user link $PWD/srstudio-catalog-web.service && systemctl --user enable --now srstudio-catalog-web.service
[Unit]
Description=Serve the scene-render catalog site

[Service]
WorkingDirectory=%h/worskpace
UMask=0077
ExecStart=%h/worskpace/.venv/bin/srstudio serve generated/catalog/site --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
