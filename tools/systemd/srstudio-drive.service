# Stages generated/outbox and copies it to gdrive:srstudio/ready-to-publish; started by srstudio-drive.path.
# Exit 1 means a video was held back by the publish gate (listed in the journal); exit 2 means the upload failed.
[Unit]
Description=Copy the ready-to-publish videos to Google Drive

[Service]
Type=oneshot
WorkingDirectory=%h/worskpace/srstudio
UMask=0077
# A delivery or package is written over several seconds: wait until neither changed for 15 s, at most 60 checks.
ExecStartPre=/bin/sh -c 'n=0; while [ "$$n" -lt 60 ] && [ -n "$$(find %h/worskpace/generated/renders/ig %h/worskpace/videos-styles -newermt "15 seconds ago" -print -quit)" ]; do sleep 5; n=$$((n + 1)); done'
ExecStart=%h/worskpace/.venv/bin/python3 episodes/publish_drive.py
SuccessExitStatus=1
Environment=SRSTUDIO_PACKAGES=%h/worskpace/generated/packages
Environment=SRSTUDIO_ENGINE=%h/worskpace/generated/bin/scene-render
