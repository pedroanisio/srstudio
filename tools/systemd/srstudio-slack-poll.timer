# Runs the Slack poller every minute.
# Install: systemctl --user link $PWD/srstudio-slack-poll.{service,timer} && systemctl --user enable --now srstudio-slack-poll.timer
[Unit]
Description=Read the Slack channel every minute

[Timer]
OnCalendar=minutely
AccuracySec=5s

[Install]
WantedBy=timers.target
